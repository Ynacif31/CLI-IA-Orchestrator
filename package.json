  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.247",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "commander": "^14.0.3",
    "ink": "^7.1.1",
    "ink-select-input": "^6.2.0",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^6.0.0",
    "js-yaml": "^5.4.0",
    "react": "^19.2.8"
  }
