{
  "name": "orchestrator",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "Multi-agent CLI orchestrator (RFC 0001)",
  "bin": {
    "orchestrator": "dist/cli.js"
  },
  "scripts": {
